<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.oo.mercado.pago.website</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment_mercado_pago.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mercado_pago_access_token']" position="after">
                <field name="mercado_pago_max_installments"/>
            </xpath>
        </field>
    </record>

</odoo>
